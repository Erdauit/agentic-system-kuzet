{
  "$defs": {
    "ModelRuntime": {
      "additionalProperties": false,
      "description": "Как запускать артефакт модели (ONNX): вход, нормализация, разбор выходов.\n\nЗначения берутся из документации/исходников модели при подготовке артефакта\n(tools/models/), а не подбираются на глаз (SPEC.md §13.3).",
      "properties": {
        "class_ids": {
          "additionalProperties": {
            "type": "integer"
          },
          "description": "Имя класса → индекс выхода",
          "title": "Class Ids",
          "type": "object"
        },
        "color": {
          "enum": [
            "rgb",
            "bgr"
          ],
          "title": "Color",
          "type": "string"
        },
        "crop_padding": {
          "anyOf": [
            {
              "exclusiveMinimum": 1.0,
              "maximum": 2.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Расширение бокса для top-down позы",
          "title": "Crop Padding"
        },
        "decoder": {
          "enum": [
            "rfdetr",
            "rtmpose_simcc",
            "detector_generic"
          ],
          "title": "Decoder",
          "type": "string"
        },
        "dynamic_batch": {
          "title": "Dynamic Batch",
          "type": "boolean"
        },
        "format": {
          "const": "onnx",
          "title": "Format",
          "type": "string"
        },
        "input_height": {
          "exclusiveMinimum": 0,
          "maximum": 4096,
          "title": "Input Height",
          "type": "integer"
        },
        "input_name": {
          "minLength": 1,
          "title": "Input Name",
          "type": "string"
        },
        "input_width": {
          "exclusiveMinimum": 0,
          "maximum": 4096,
          "title": "Input Width",
          "type": "integer"
        },
        "keypoints": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 256,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Keypoints"
        },
        "mean": {
          "description": "Вычитается после перевода в шкалу scale",
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Mean",
          "type": "array"
        },
        "outputs": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Outputs",
          "type": "array"
        },
        "scale": {
          "description": "Делитель пикселей перед нормализацией: 255 или 1",
          "exclusiveMinimum": 0,
          "title": "Scale",
          "type": "number"
        },
        "simcc_split_ratio": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Simcc Split Ratio"
        },
        "std": {
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Std",
          "type": "array"
        }
      },
      "required": [
        "format",
        "input_name",
        "input_width",
        "input_height",
        "color",
        "mean",
        "std",
        "scale",
        "outputs",
        "dynamic_batch",
        "decoder"
      ],
      "title": "ModelRuntime",
      "type": "object"
    },
    "ModelSource": {
      "enum": [
        "pretrained",
        "qoima",
        "trained"
      ],
      "title": "ModelSource",
      "type": "string"
    },
    "ModelStatus": {
      "enum": [
        "candidate",
        "shadow",
        "active",
        "retired",
        "rejected"
      ],
      "title": "ModelStatus",
      "type": "string"
    },
    "TaskType": {
      "enum": [
        "detection",
        "segmentation",
        "keypoints",
        "anomaly",
        "classification"
      ],
      "title": "TaskType",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "framework": {
      "maxLength": 60,
      "minLength": 1,
      "title": "Framework",
      "type": "string"
    },
    "golden_set_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Golden Set Version"
    },
    "license": {
      "description": "SPDX-выражение лицензии весов",
      "maxLength": 120,
      "minLength": 1,
      "title": "License",
      "type": "string"
    },
    "metrics": {
      "additionalProperties": {
        "type": "number"
      },
      "title": "Metrics",
      "type": "object"
    },
    "name": {
      "pattern": "^[a-z0-9][a-z0-9_\\-]{0,63}$",
      "title": "Name",
      "type": "string"
    },
    "promoted_by": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Promoted By"
    },
    "runtime": {
      "anyOf": [
        {
          "$ref": "#/$defs/ModelRuntime"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "source": {
      "$ref": "#/$defs/ModelSource"
    },
    "status": {
      "$ref": "#/$defs/ModelStatus"
    },
    "task_type": {
      "$ref": "#/$defs/TaskType"
    },
    "training_task_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Training Task Id"
    },
    "version": {
      "pattern": "^\\d+\\.\\d+\\.\\d+([-+][0-9A-Za-z.\\-]+)?$",
      "title": "Version",
      "type": "string"
    },
    "weights_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Weights Sha256",
      "type": "string"
    }
  },
  "required": [
    "name",
    "version",
    "task_type",
    "framework",
    "license",
    "weights_sha256",
    "source",
    "status",
    "created_at"
  ],
  "title": "ModelManifest",
  "type": "object"
}
