.venv-cli/
__pycache__/
*.pyc
.mypy_cache/
.ruff_cache/
.pytest_cache/
dist/
build/
*.egg-info/

# UI
ui/node_modules/
ui/dist/
ui/*.tsbuildinfo

# Редакторы и ОС
.DS_Store
.idea/
.vscode/
